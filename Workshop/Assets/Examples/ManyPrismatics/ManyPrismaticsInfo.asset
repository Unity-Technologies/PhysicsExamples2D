  m_Scene: {fileID: 102900000, guid: 632d3f99cef30ad4db885840f30916dd, type: 3}
  m_ScenePath: Assets/Examples/ManyPrismatics/ManyPrismatics.unity
  m_ExampleName: Many Prismatics
  m_Category: Joints
  m_Description: A chain of slider joints that stays stable when it is stretched. Drag a box sideways to distort the chain.
  m_Purpose: "A chain of boxes joined by slider joints, stretched to the end of their limits.\nThe number of sub-steps the world takes in each step decides how well stretched joints hold. With too few, the chain bends away from its slide axis."
  m_Controls: "World Sub-Steps: sets how many sub-steps the world takes in each step. Raise it and the chain holds straight, lower it and the chain bends.\nDrag a box sideways to distort the chain and see how quickly it recovers."
  m_State:
    overriddenDrawOptions: 128
    fixedDrawOptions: 128
    sleeping: 0
    frameRateVisible: 0
    catchUpSteps: 0
    subSteps: 4
