  m_Script: {fileID: 11500000, guid: 425f70a701d340949ad6110bc3f45d64, type: 3}
  m_Name: WheelJointInfo
  m_EditorClassIdentifier: Assembly-CSharp::WorkshopExampleInfo
  m_Scene: {fileID: 102900000, guid: 041b5ba97b33fce4ebd5192aaea4450c, type: 3}
  m_ScenePath: Assets/Examples/WheelJoint/WheelJoint.unity
  m_ExampleName: Wheel Joint
  m_Category: Joints
  m_Purpose: "Demonstrates the wheel joint, which lets a body slide along one axis against a spring while it rotates freely, the way a car wheel moves on its suspension. It has the spring, limits on the slide, and a motor that spins the wheel.\nA wheel is held on a wheel joint to a fixed point so every setting can be tried."
  m_Controls: "Wheel Angle: the direction of the slide axis. The wheel is rebuilt when it changes.\nEnable Spring with Spring Frequency and Spring Damping: the suspension spring.\nEnable Motor with Motor Speed and Max Motor Torque: spins the wheel.\nEnable Limit with Min Distance Limit and Max Distance Limit: limits how far it can slide."
  m_Description: Demonstrating the features of the Wheel Joint.
  m_State:
    overriddenDrawOptions: 128
    fixedDrawOptions: 128
    sleeping: 0
    frameRateVisible: 0
    catchUpSteps: 0
