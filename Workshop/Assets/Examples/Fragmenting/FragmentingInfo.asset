  m_Script: {fileID: 11500000, guid: 425f70a701d340949ad6110bc3f45d64, type: 3}
  m_Name: FragmentingInfo
  m_EditorClassIdentifier: Assembly-CSharp::WorkshopExampleInfo
  m_Scene: {fileID: 102900000, guid: 84f457b4bb8630a4db20c4cebf6a3d37, type: 3}
  m_ScenePath: Assets/Examples/Fragmenting/Fragmenting.unity
  m_ExampleName: Fragmenting
  m_Category: Advanced
  m_Purpose: "Demonstrates fragmenting geometry with the physics destructor. A region is cut out of a shape and split into pieces around random points, and what is left becomes the new shape.\nProjectiles fired at a large slab break a round hole out of it wherever they hit, and the pieces fall through a field of obstacles."
  m_Controls: "Left and Right arrow keys, or the Left and Right buttons: move the player.\nSpace, or the Fire button: fire a projectile.\nFragment Radius, Fragment Count and Fragment Explode: the size of each hole, how many pieces it breaks into, and how hard they are blown apart. They take effect from the next hit."
  m_Description: Demonstrates the use of geometry fragmenting.
