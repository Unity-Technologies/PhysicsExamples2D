  m_Script: {fileID: 11500000, guid: 425f70a701d340949ad6110bc3f45d64, type: 3}
  m_Name: CharacterMoverInfo
  m_EditorClassIdentifier: Assembly-CSharp::WorkshopExampleInfo
  m_Scene: {fileID: 102900000, guid: 9b6abc2b0dd11f542a924e2f6824e482, type: 3}
  m_ScenePath: Assets/Examples/CharacterMover/CharacterMover.unity
  m_ExampleName: Character Mover
  m_Category: Shapes
  m_Purpose: "Demonstrates the cast mover, which moves a shape through the world by casting it and sliding it along whatever it hits, for a character controller that is not a physics body. A spring-like pogo, driven by a downward cast, holds the character off the ground.\nThe character walks over steps, a hanging bridge, loose debris and a moving lift."
  m_Controls: "Left and Right arrow keys, or the Left and Right buttons: walk.\nSpace, or the Jump button: jump.\nJump Speed, Min Speed, Max Speed, Stop Speed, Accelerate, Air Steer, Friction and Gravity: how the character walks and jumps.\nPogo Scale, Pogo Frequency, Pogo Damping and Pogo Type: how the pogo holds the character off the ground."
  m_Description: Demonstrating the Cast Mover feature.
  m_State:
    overriddenDrawOptions: 128
    fixedDrawOptions: 0
    sleeping: 0
    frameRateVisible: 0
    catchUpSteps: 0
