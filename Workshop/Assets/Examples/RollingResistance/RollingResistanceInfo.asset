  m_Script: {fileID: 11500000, guid: 425f70a701d340949ad6110bc3f45d64, type: 3}
  m_Name: RollingResistanceInfo
  m_EditorClassIdentifier: Assembly-CSharp::WorkshopExampleInfo
  m_Scene: {fileID: 102900000, guid: 70f650c0e02e54f43b13d4d86f34e60c, type: 3}
  m_ScenePath: Assets/Examples/RollingResistance/RollingResistance.unity
  m_ExampleName: Rolling Resistance
  m_Category: Shapes
  m_Purpose: "Demonstrates rolling resistance, the surface material property that slows a shape's spin as it rolls, the way a real tire loses energy on the ground. Without it, a ball on a flat surface rolls forever.\nTwenty balls roll down stacked ramps, each with a little more rolling resistance than the one below, so the lowest keeps rolling long after the highest has stopped."
  m_Controls: "Slope Type: the tilt of every ramp. The whole stack is rebuilt when it changes."
  m_Description: Demonstrating Rolling Resistance Surface Property.
