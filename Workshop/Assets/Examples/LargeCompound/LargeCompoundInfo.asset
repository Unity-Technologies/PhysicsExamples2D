  m_Name: LargeCompoundInfo
  m_EditorClassIdentifier: Assembly-CSharp::WorkshopExampleInfo
  m_Scene: {fileID: 102900000, guid: 55b04be2cba5b394db8e6e8f99a59c47, type: 3}
  m_ScenePath: Assets/Examples/LargeCompound/LargeCompound.unity
  m_ExampleName: Large Compound
  m_Category: Benchmarks
  m_Purpose: "A stress test of compound bodies, both for performance and stability. A body can carry many shapes, and each body here is a solid square made of many separate box shapes.\nThe same amount of material is always dropped, so more splits means more bodies with fewer shapes each. Changing the split shows the trade-off between a few bodies with many shapes and many bodies with few shapes.\nEach body's mass is calculated once after all of its shapes are added, rather than again for every shape, which matters when a body has this many shapes."
  m_Controls: "Compound Size: how much material is dropped.\nCompound Splits: how many bodies it is divided into.\nA fresh set is dropped when either changes."
  m_Description: Many large dynamic compound bodies dropped into a container.
  m_State:
    overriddenDrawOptions: 0
    fixedDrawOptions: 0
    sleeping: 0
    frameRateVisible: 0
    catchUpSteps: 0
